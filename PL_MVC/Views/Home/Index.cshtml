@model ML.HomeViewModel
@{
    ViewData["Title"] = "Zona de noticias";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
}

@if (Model.NoticiaRelevante != null)
{
    <div class="modal fade" id="modalNoticiaRelevante" tabindex="-1" aria-labelledby="modalNoticiaRelevanteLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content b-modal">
                <div class="modal-header b-modal-header">
                    <h5 class="modal-title b-modal-title" id="modalNoticiaRelevanteLabel">Noticia Destacada</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body b-modal-body">
                    <h3 class="b-noticia-titulo-modal">@Model.NoticiaRelevante.Titulo</h3>
                    <p class="b-noticia-fecha"><i class="bi bi-clock me-1"></i> @Model.NoticiaRelevante.FechaPublicacion?.ToString("dd/MM/yyyy HH:mm")</p>
                    
                    @if (!string.IsNullOrEmpty(Model.NoticiaRelevante.ImagenBase64))
                    {
                        <div class="b-imagen-contenedor-modal">
                            <img src="data:image/jpeg;base64,@Model.NoticiaRelevante.ImagenBase64" class="b-imagen-modal" alt="Noticia">
                        </div>
                    }
                    <div class="b-noticia-contenido-modal">
                        @Model.NoticiaRelevante.Contenido
                    </div>
                </div>
                <div class="modal-footer b-modal-footer">
                    <button type="button" class="btn b-btn-secundario" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}



        @if (Context.User.IsInRole("Administrador"))
        {
            <button type="button" class="btn b-btn-primario" data-bs-toggle="modal" data-bs-target="#modalAñadirNoticia">
                <i class="bi bi-plus-lg me-2"></i> Añadir Noticia
            </button>
        }
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">
            @if (Model.Noticias != null && Model.Noticias.Any())
            {
                <div class="b-feed-noticias">
                    @foreach (ML.Noticia noticia in Model.Noticias)
                    {
                        <div class="card b-tarjeta-noticia">
                            @if (!string.IsNullOrEmpty(noticia.ImagenBase64))
                            {
                                <div class="b-imagen-contenedor-tarjeta">
                                    <img src="data:image/jpeg;base64,@noticia.ImagenBase64" class="b-imagen-tarjeta" alt="Imagen noticia">
                                </div>
                            }
                            <div class="card-body b-cuerpo-tarjeta">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h4 class="card-title b-noticia-titulo">@noticia.Titulo</h4>
                                    @if (Context.User.IsInRole("Administrador"))
                                    {
                                        <form asp-controller="Home" asp-action="EliminarNoticia" method="post" onsubmit="return confirm('¿Eliminar esta noticia permanentemente?');">
                                            <input type="hidden" name="idNoticia" value="@noticia.IdNoticia" />
                                            <button type="submit" class="btn b-btn-icono-peligro" title="Eliminar noticia">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                                <p class="b-noticia-fecha mb-3">
                                    @noticia.FechaPublicacion?.ToString("dd/MM/yyyy")
                                </p>
                                <p class="card-text b-noticia-extracto">@noticia.Contenido</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="b-estado-vacio">
                    <p>No hay noticias publicadas en este momento.</p>
                </div>
            }
        </div>
    </div>
</div>

@if (Context.User.IsInRole("Administrador"))
{
    <div class="modal fade" id="modalAñadirNoticia" tabindex="-1" aria-labelledby="modalAñadirNoticiaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-controller="Home" asp-action="AgregarNoticia" method="post" enctype="multipart/form-data" class="w-100">
                <div class="modal-content b-modal">
                    <div class="modal-header b-modal-header border-bottom-0 pt-4 px-4">
                        <h5 class="modal-title b-modal-title" id="modalAñadirNoticiaLabel">Nueva Noticia</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-4">
                            <label for="titulo" class="form-label b-label">Título</label>
                            <input type="text" class="form-control b-input" id="titulo" name="titulo" required>
                        </div>
                        <div class="mb-4">
                            <label for="contenido" class="form-label b-label">Contenido</label>
                            <textarea class="form-control b-input" id="contenido" name="contenido" rows="6" required></textarea>
                        </div>
                        <div class="mb-2">
                            <label for="imagen" class="form-label b-label">Imagen <span class="fw-normal text-muted" style="font-size: 0.85rem;">(Opcional)</span></label>
                            <input class="form-control b-input" type="file" id="imagen" name="imagen" accept="image/*">
                        </div>
                    </div>
                    <div class="modal-footer b-modal-footer border-top-0 pb-4 px-4">
                        <button type="button" class="btn b-btn-secundario" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn b-btn-primario">Publicar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (Model.NoticiaRelevante != null)
            {
                <text>
                var myModalEl = document.getElementById('modalNoticiaRelevante');
                if (myModalEl) {
                    var myModal = new bootstrap.Modal(myModalEl, {
                        keyboard: true
                    });
                    myModal.show();
                }
                </text>
            }
        });
    </script>
}