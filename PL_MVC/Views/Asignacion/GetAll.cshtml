@model ML.AsignacionDocente

@{
    ViewData["Title"] = "Asignaciones Docentes";
}

<style>
    .table-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        padding: 20px;
        margin-top: 20px;
    }
    .badge-dia {
        background-color: #7B2037;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-weight: 500;
        font-size: 0.85rem;
    }
</style>

<div class="container-fluid">
    <div class="table-card">
        <div class="row align-items-center mb-4">
            <div class="col">
                <h2 class="fw-bold mb-0" style="color: #2d3436;"><i class="bi bi-calendar-event text-danger"></i> Asignaciones Docentes</h2>
                <p class="text-muted mb-0">Listado de materias, grupos y horarios programados para los docentes.</p>
            </div>
            <div class="col-auto">
                <a href="@Url.Action("AsignacionAdd", "Asignacion")" class="btn btn-danger rounded-pill shadow-sm" style="background-color: #7B2037; border: none;">
                    <i class="bi bi-plus-lg"></i> Nueva Asignación
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-warning shadow-sm">
                <i class="bi bi-info-circle-fill me-2"></i> @ViewBag.Message
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Docente</th>
                        <th>Materia</th>
                        <th>Semestre / Grupo</th>
                        <th>Día de Clase</th>
                        <th>Horario</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Asignaciones != null && Model.Asignaciones.Count > 0)
                    {
                        foreach (ML.AsignacionDocente asignacion in Model.Asignaciones)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3" style="width: 38px; height: 38px; border-radius: 50%; background-color: #e3f2fd; color: #1e88e5; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                                            @(asignacion.Empleado?.Nombre?.Substring(0, 1))@(asignacion.Empleado?.ApellidoPaterno?.Substring(0, 1))
                                        </div>
                                        <div>
                                            <span class="fw-bold">@asignacion.Empleado?.Nombre @asignacion.Empleado?.ApellidoPaterno @asignacion.Empleado?.ApellidoMaterno</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold">@asignacion.Materia?.Nombre</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">Semestre @asignacion.Materia?.Semestre</span>
                                    <span class="badge bg-info text-dark">Grupo @asignacion.Grupo?.Letra (@asignacion.Grupo?.Turno)</span>
                                </td>
                                <td>
                                    <span class="badge badge-dia">@asignacion.DiaSemana</span>
                                </td>
                                <td class="font-monospace">
                                    @asignacion.HoraInicio.ToString(@"hh\:mm") - @asignacion.HoraFin.ToString(@"hh\:mm")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>
                                No se encontraron asignaciones programadas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
