@model List<ML.Alumno>

@{
    ViewData["Title"] = "Alumnos - GetAll";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Alumno/GetAll.css" asp-append-version="true" />
}

<div class="container-fluid">
    <div class="table-card">
        <h2 class="mb-4 fw-bold" style="color: #2d3436;">Alumnos - GetAll</h2>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-danger shadow-sm alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success shadow-sm alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger shadow-sm alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover mb-0 table-compacta">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Matrícula</th>
                        <th>CURP</th>
                        <th>Nombre</th>
                        <th>A. Paterno</th> 
                        <th>A. Materno</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Especialidad</th>
                        <th>Grupo</th>
                        <th>Estatus</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var alumno in Model)
                        {
                            <tr>
                                <td class="text-center">@alumno.idAlumno</td>
                                <td>@alumno.Matricula</td>
                                <td>@alumno.Curp</td>
                                <td>@alumno.Nombre</td>
                                <td>@alumno.ApellidoPaterno</td>
                                <td>@alumno.ApellidoMaterno</td>
                                <td>@alumno.Correo</td>
                                <td>@alumno.Telefono</td>
                                @if (string.IsNullOrEmpty(alumno.Especialidad?.Nombre))
                                {
                                    <td class="text-muted fst-italic">Sin especialidad</td>
                                }
                                else
                                {
                                    <td>@(alumno.Especialidad?.Nombre)</td>
                                }
                                <td>@(alumno.Grupo?.Semestre) - @(alumno.Grupo?.Letra) (@(alumno.Grupo?.Turno))</td>
                                <td class="text-center">
                                    @if (alumno.Estatus == "Baja")
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-2">Baja</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">Activo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="@Url.Action("Boleta", "Reporte", new { idAlumno = alumno.idAlumno })" class="btn btn-sm btn-outline-info rounded-pill">
                                            <i class="bi bi-file-earmark-pdf"></i> Boleta
                                        </a>
                                        @if (alumno.Estatus == "Baja")
                                        {
                                            <a href="@Url.Action("ChangeStatus", "Alumno", new { idAlumno = alumno.idAlumno, estatus = "Activo" })" class="btn btn-sm btn-outline-success rounded-pill" onclick="return confirm('¿Está seguro de que desea reactivar a este alumno?');">
                                                <i class="bi bi-person-check"></i> Activar
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("ChangeStatus", "Alumno", new { idAlumno = alumno.idAlumno, estatus = "Baja" })" class="btn btn-sm btn-outline-danger rounded-pill" onclick="return confirm('¿Está seguro de que desea dar de baja a este alumno?');">
                                                <i class="bi bi-person-dash"></i> Dar de Baja
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center py-4 text-muted">
                                No hay alumnos disponibles.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>