@using BL
@model ML.Alumno
@{
    ViewData["Title"] = "Agregar Alumno";
}

<div class="mt-4">
    <p class="d-inline-flex gap-1">
        <a class="btn btn-primary" data-bs-toggle="collapse" href="#collapseCargaMasiva" role="button" aria-expanded="false" aria-controls="collapseCargaMasiva">
            <i class="bi bi-file-earmark-excel me-1"></i> CARGA MASIVA
        </a>
    </p>
    <div class="collapse" id="collapseCargaMasiva">
        <form action="@Url.Action("CargaMasiva", "Alumno")" method="POST" enctype="multipart/form-data">
            <div class="input-group mb-3">
                <input type="file" name="archivoExcel" class="form-control" id="inputGroupFile04" accept=".xlsx" required>
                
                <button class="btn btn-success px-4" type="submit">
                    <i class="bi bi-upload me-2"></i> Subir Excel
                </button>
            </div>
        </form>
    </div>
</div>



@* <div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 text-center text-md-start">
            <h1 class="display-5 fw-bold text-primary mb-2">Agregar Alumno</h1>
            <p class="text-muted lead">Ingresa los datos del nuevo alumno.</p>
        </div>
    </div> *@

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="fs-4 bi bi-exclamation-triangle-fill text-danger me-2"></i> @ViewBag.Message
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 p-md-5">
                    @using (Html.BeginForm("AlumnoAdd", "Alumno", FormMethod.Post, new { id = "alumnoForm", enctype = "multipart/form-data" }))
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="Nombre" class="form-label fw-semibold">Nombre</label>
                                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", id = "Nombre", placeholder = "Ej: Emmanuel" })
                                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">El nombre es obligatorio y sólo debe contener letras.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="ApellidoPaterno" class="form-label fw-semibold">Apellido Paterno</label>
                                @Html.TextBoxFor(m => m.ApellidoPaterno, new { @class = "form-control", id = "ApellidoPaterno", placeholder = "Ej: Rodríguez" })
                                @Html.ValidationMessageFor(m => m.ApellidoPaterno, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">El apellido paterno es obligatorio y sólo debe contener letras.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="ApellidoMaterno" class="form-label fw-semibold">Apellido Materno</label>
                                @Html.TextBoxFor(m => m.ApellidoMaterno, new { @class = "form-control", id = "ApellidoMaterno", placeholder = "Ej: Flores" })
                                @Html.ValidationMessageFor(m => m.ApellidoMaterno, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">El apellido materno sólo debe contener letras si se especifica.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="Matricula" class="form-label fw-semibold">Matrícula</label>
                                @Html.TextBoxFor(m => m.Matricula, new { @class = "form-control", id = "Matricula", placeholder = "Ej: 123456789" })
                                @Html.ValidationMessageFor(m => m.Matricula, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">La matrícula es obligatoria y sólo debe contener números.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="Curp" class="form-label fw-semibold">CURP</label>
                                @Html.TextBoxFor(m => m.Curp, new { @class = "form-control", id = "Curp", placeholder = "Ej: ROFE000101XXXXXXXX" })
                                @Html.ValidationMessageFor(m => m.Curp, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">El CURP es obligatorio y debe tener un formato oficial válido (18 caracteres).</div>
                            </div>
                            <div class="col-md-6">
                                <label for="Correo" class="form-label fw-semibold">Correo</label>
                                @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", id = "Correo", placeholder = "Ej: alumno@cbtis.edu.mx", type = "email" })
                                @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">El correo electrónico no tiene un formato válido.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="Telefono" class="form-label fw-semibold">Teléfono</label>
                                @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", id = "Telefono", placeholder = "Ej: 5551234567" })
                                @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">El teléfono debe contener exactamente 10 dígitos numéricos.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="Celular" class="form-label fw-semibold">Celular</label>
                                @Html.TextBoxFor(m => m.Celular, new { @class = "form-control", id = "Celular", placeholder = "Ej: 5559876543" })
                                @Html.ValidationMessageFor(m => m.Celular, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">El celular debe contener exactamente 10 dígitos numéricos.</div>
                            </div>
                            
                            <div class="col-md-6">
                                @Html.LabelFor(m=>Model.Grupo.Semestre, "Semestre", new { @class = "form-label fw-semibold" })
                                @Html.DropDownListFor(
                                    m=> Model.Grupo.Semestre,
                                     new SelectList(Model.Grupo.semestres),
                                     "Seleccione un Semestre",
                                     new {@class = "form-select", @id="ddlsemestre"})
                                @Html.ValidationMessageFor(m => m.Grupo.Semestre, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">Seleccione un semestre.</div>
                            </div>    

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Turno</label>
                                <select id="ddlTurno" class="form-select" disabled>
                                    <option value="">Primero seleccione Semestre</option>
                                </select>
                                <div class="invalid-feedback">Seleccione un turno.</div>
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Grupo.IdGrupo, "Grupo", new { @class = "form-label fw-semibold" })
                                <select name="Grupo.IdGrupo" id="ddlGrupo" class="form-select" disabled>
                                    <option value="">Seleccione SEMESTRE</option>
                                    @foreach (ML.Grupo grupo in Model.Grupo.grupos)
                                    {
                                        <option value="@grupo.IdGrupo" data-semestre="@grupo.Semestre" data-turno="@grupo.Turno">
                                            Grupo @grupo.Letra
                                        </option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.Grupo.IdGrupo, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">Seleccione un grupo.</div>
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => Model.Especialidad, "Especialidad", new { @class = "form-label fw-semibold" })
                                @Html.DropDownListFor(
                                    m => m.Especialidad.IdEspecialidad, 
                                    new SelectList(Model.Especialidad.Especialidades, "IdEspecialidad", "Nombre"), 
                                    "Seleccione una especialidad", 
                                    new { @class = "form-select", @id = "ddlEspecialidad" }
                                )
                                @Html.ValidationMessageFor(m => m.Especialidad.IdEspecialidad, "", new { @class = "text-danger" })
                                <div class="invalid-feedback">Seleccione una especialidad.</div>
                            </div>

                            <div class="col-12 mt-4 text-center">
                                <a href="@Url.Action("GetAll", "Alumno")" class="btn btn-outline-secondary px-4 me-2">
                                    <i class="bi bi-arrow-left me-2"></i>Regresar
                                </a>
                                <button type="submit" class="btn btn-success px-4">
                                    <i class="bi bi-save me-2"></i>Guardar Alumno
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Alumno/AlumnoAdd.js" asp-append-version="true"></script>
}