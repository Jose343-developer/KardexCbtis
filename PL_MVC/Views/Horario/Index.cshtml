@model List<ML.AsignacionDocente>
@{
    ViewData["Title"] = "Horarios por Semestre y Grupo";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Horarios por Semestre y Grupo</h2>
        @if (Context.User.IsInRole("Administrador") || Context.User.IsInRole("Profesor"))
        {
            <a asp-controller="Asignacion" asp-action="GetAll" class="btn btn-primary">Administrar Horarios</a>
        }
    </div>

    @{
        var groupedSchedules = Model
            .Where(m => m.Grupo != null && m.Materia != null)
            .GroupBy(m => new { m.Grupo.Semestre, m.Grupo.Letra, m.Grupo.Turno })
            .OrderBy(g => g.Key.Semestre).ThenBy(g => g.Key.Letra)
            .ToList();
    }

    @if (!groupedSchedules.Any())
    {
        <div class="alert alert-info">No hay horarios establecidos actualmente.</div>
    }
    else
    {
        <div class="accordion" id="accordionHorarios">
            @foreach (var group in groupedSchedules)
            {
                var groupId = $"collapse_{group.Key.Semestre}_{group.Key.Letra}";
                <div class="accordion-item mb-3 border rounded shadow-sm">
                    <h2 class="accordion-header" id="heading_@groupId">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@groupId" aria-expanded="false" aria-controls="@groupId">
                            <strong>Semestre @group.Key.Semestre - Grupo '@group.Key.Letra' (@group.Key.Turno)</strong>
                        </button>
                    </h2>
                    <div id="@groupId" class="accordion-collapse collapse" aria-labelledby="heading_@groupId" data-bs-parent="#accordionHorarios">
                        <div class="accordion-body">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped table-hover align-middle">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Día</th>
                                            <th>Horario</th>
                                            <th>Materia</th>
                                            <th>Docente</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in group.OrderBy(i => i.DiaSemana).ThenBy(i => i.HoraInicio))
                                        {
                                            <tr>
                                                <td class="fw-bold">@item.DiaSemana</td>
                                                <td>@item.HoraInicio.ToString(@"hh\:mm") - @item.HoraFin.ToString(@"hh\:mm")</td>
                                                <td>@item.Materia.Nombre</td>
                                                <td>@(item.Empleado?.Nombre) @(item.Empleado?.ApellidoPaterno)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
