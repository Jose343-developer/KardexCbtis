@model ML.Horario

@{
    ViewData["Title"] = "Mi Horario";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">@ViewData["Title"]</h2>
            <p class="text-muted">Horario del Grupo @Model.Grupo?.Semestre @Model.Grupo?.Letra - @Model.Grupo?.Turno</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <!-- Embeber el PDF para previsualización -->
            <embed src="@Model.DocumentoRuta" type="application/pdf" width="100%" height="600px" style="border-radius: 1rem;" />
        </div>
        <div class="card-footer text-center py-3 bg-light border-0 rounded-bottom-4">
            <a href="@Model.DocumentoRuta" class="btn btn-primary" download>
                <i class="bi bi-download"></i> Descargar Horario
            </a>
        </div>
    </div>
</div>
