@{
    ViewData["Title"] = "Horario No Encontrado";
}

<div class="container mt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <i class="bi bi-calendar-x text-muted mb-3" style="font-size: 5rem;"></i>
                <h2 class="fw-bold text-dark mb-3">Horario no disponible</h2>
                <p class="text-muted fs-5 mb-4">
                    Al parecer, aún no tienes un grupo asignado o tu grupo no cuenta con un horario registrado en el sistema.
                </p>
                <p class="text-muted mb-4">
                    Por favor, contacta con control escolar si crees que esto es un error o espera a que publiquen los horarios de este semestre.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill">
                    <i class="bi bi-house-door me-2"></i> Volver al Inicio
                </a>
            </div>
        </div>
    </div>
</div>
