@model ML.Materia
@{
    ViewData["Title"] = "Agregar Materia";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Materia/MateriaAdd.css" asp-append-version="true" />
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-guinda text-white p-4">
                <h3 class="card-title mb-0 fw-bold"><i class="bi bi-journal-plus me-2"></i>Nueva Materia</h3>
                <p class="mb-0 text-white-50 small">Ingresa la información detallada para registrar la materia en el catálogo.</p>
            </div>
            <div class="card-body p-4 p-md-5">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger shadow-sm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage
                    </div>
                }

                @using (Html.BeginForm("MateriaAdd", "Materia", FormMethod.Post, new { id = "materiaForm" }))
                {
                    <div class="row g-4">
                        <div class="col-12">
                            <label for="Nombre" class="form-label fw-semibold">Nombre de la Materia</label>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", id = "Nombre", placeholder = "Ej: Álgebra, Química, Inglés I" })
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <div class="col-md-6">
                            <label for="Semestre" class="form-label fw-semibold">Semestre</label>
                            @Html.DropDownListFor(
                                m => m.Semestre, 
                                new SelectList(new[] { 1, 2, 3, 4, 5, 6 }), 
                                "Seleccione un semestre", 
                                new { @class = "form-select", id = "Semestre" }
                            )
                            @Html.ValidationMessageFor(m => m.Semestre, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <div class="col-md-6">
                            <label for="Creditos" class="form-label fw-semibold">Créditos</label>
                            @Html.TextBoxFor(
                                m => m.Creditos, 
                                new { @class = "form-control", id = "Creditos", type = "number", min = "1", max = "20", placeholder = "Ej: 5" }
                            )
                            @Html.ValidationMessageFor(m => m.Creditos, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <div class="col-12">
                            <label for="ddlEspecialidad" class="form-label fw-semibold">Especialidad (Opcional)</label>
                            @Html.DropDownListFor(
                                m => m.Especialidad.IdEspecialidad, 
                                new SelectList(Model.Especialidad.Especialidades, "IdEspecialidad", "Nombre"), 
                                "Seleccione una especialidad (Tronco Común)", 
                                new { @class = "form-select", id = "ddlEspecialidad" }
                            )
                            @Html.ValidationMessageFor(m => m.Especialidad.IdEspecialidad, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <div class="col-12 mt-5 text-center">
                            <a href="@Url.Action("GetAll", "Materia")" class="btn btn-outline-secondary px-4 me-2 rounded-pill">
                                <i class="bi bi-arrow-left me-2"></i>Regresar
                            </a>
                            <button type="submit" class="btn btn-success px-4 rounded-pill shadow-sm">
                                <i class="bi bi-save me-2"></i>Guardar Materia
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Materia/MateriaAdd.js" asp-append-version="true"></script>
}
