@model ML.Login
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - CBTis 133</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311042 100%);
            --primary: #6366f1;
            --primary-hover: #4f46e5;
            --accent: #d946ef;
            --card-bg: rgba(30, 41, 59, 0.45);
            --card-border: rgba(255, 255, 255, 0.08);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-main);
            margin: 0;
            overflow-x: hidden;
        }

        .login-wrapper {
            position: relative;
            width: 100%;
            max-width: 450px;
            padding: 20px;
            z-index: 10;
        }

        /* Decorative glowing circles behind the card */
        .glow-circle {
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.3;
            z-index: 1;
        }
        .glow-1 {
            background: var(--primary);
            top: -50px;
            left: -50px;
        }
        .glow-2 {
            background: var(--accent);
            bottom: -50px;
            right: -50px;
        }

        .login-card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 40px;
            box-shadow: var(--glass-shadow);
            z-index: 5;
            position: relative;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .login-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.5);
        }

        .brand-container {
            text-align: center;
            margin-bottom: 35px;
        }

        .brand-logo {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            object-fit: cover;
            border: 2px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 15px;
            box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
        }

        .brand-title {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: linear-gradient(to right, #ffffff, #c7d2fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 0;
        }

        .brand-subtitle {
            font-size: 14px;
            color: var(--text-muted);
            margin-top: 5px;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #cbd5e1;
            margin-bottom: 8px;
            display: inline-block;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 24px;
        }

        .form-control-custom {
            width: 100%;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 14px 16px 14px 45px;
            color: #f8fafc;
            font-size: 15px;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-control-custom:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2);
            background: rgba(15, 23, 42, 0.8);
        }

        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 18px;
            transition: color 0.3s ease;
        }

        .form-control-custom:focus + .input-icon {
            color: var(--primary);
        }

        .btn-login {
            background: linear-gradient(135deg, var(--primary) 0%, #4f46e5 100%);
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 600;
            font-size: 16px;
            color: white;
            width: 100%;
            margin-top: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
        }

        .btn-login:hover {
            background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .validation-summary-errors {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            color: #fca5a5;
            font-size: 14px;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

        .field-validation-error {
            color: #fca5a5;
            font-size: 12px;
            margin-top: 5px;
            display: block;
        }

        .footer-text {
            text-align: center;
            margin-top: 25px;
            font-size: 13px;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="glow-circle glow-1"></div>
        <div class="glow-circle glow-2"></div>

        <div class="login-card">
            <div class="brand-container">
                <img src="~/images/003.jpg" alt="Logo CBTis 133" class="brand-logo" />
                <h1 class="brand-title">Control Escolar</h1>
                <p class="brand-subtitle">CBTis No. 133</p>
            </div>

            @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { id = "loginForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    <label class="form-label" for="Correo">Usuario o Correo</label>
                    <div class="input-group-custom">
                        @Html.TextBoxFor(m => m.Correo, new { @class = "form-control-custom", id = "Correo", placeholder = "ej. admin, maria.lopez, etc.", autocomplete = "off" })
                        <i class="bi bi-person input-icon"></i>
                        @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="Password">Contraseña</label>
                    <div class="input-group-custom">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control-custom", id = "Password", placeholder = "••••••••" })
                        <i class="bi bi-lock input-icon"></i>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                </div>

                <button type="submit" class="btn-login">
                    Iniciar Sesión <i class="bi bi-arrow-right ms-2"></i>
                </button>
            }

            <div class="footer-text">
                &copy; @DateTime.Now.Year CBTIS No. 133. Todos los derechos reservados.
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
