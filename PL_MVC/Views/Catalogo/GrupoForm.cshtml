@model ML.Grupo

@{
    ViewData["Title"] = Model.IdGrupo > 0 ? "Editar Grupo" : "Nuevo Grupo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Catalogo/FormulariosGrup.css" asp-append-version="true" />
}

<div class="container-fluid mt-4 px-4 b-contenedor-principal">
<div class="row g-5 justify-content-center b-area">

    </div>

    <div class="row justify-content-center b-area-formulario">
        <div class="col-md-10 col-lg-8">
            <div class="card b-tarjeta-formulario">
                <div class="card-body p-5">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-danger b-alerta-error mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> @ViewBag.Message
                        </div>
                    }

                    <form asp-action="GrupoForm" method="post" class="b-formulario">
                        <input type="hidden" asp-for="IdGrupo" />

                        <div class="row g-4 mb-5">
                            <div class="col-md-4">
                                <label asp-for="Semestre" class="form-label b-label">Semestre <span class="b-requerido">*</span></label>
                                <select asp-for="Semestre" class="form-select b-input" required>
                                    <option value="">Seleccione...</option>
                                    <option value="1">1er Semestre</option>
                                    <option value="2">2do Semestre</option>
                                    <option value="3">3er Semestre</option>
                                    <option value="4">4to Semestre</option>
                                    <option value="5">5to Semestre</option>
                                    <option value="6">6to Semestre</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Letra" class="form-label b-label">Letra (Grupo) <span class="b-requerido">*</span></label>
                                <input asp-for="Letra" class="form-control b-input" maxlength="1" style="text-transform: uppercase;" required placeholder="Ej. A" />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Turno" class="form-label b-label">Turno <span class="b-requerido">*</span></label>
                                <select asp-for="Turno" class="form-select b-input" required>
                                    <option value="">Seleccione...</option>
                                    <option value="M">Matutino</option>
                                    <option value="V">Vespertino</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-4 border-top b-acciones-formulario">
                            <a asp-action="Grupos" class="btn b-btn-secundario">Cancelar</a>
                            <button type="submit" class="btn b-btn-primario">
                                <i class="bi bi-check2 me-2"></i> Guardar Grupo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>