@model List<ML.Especialidad>

@{
    ViewData["Title"] = "Especialidades";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Catalogo/Especialidades.css" asp-append-version="true" />
}

<div class="container-fluid mt-4 px-4 b-contenedor-principal">
    <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom b-header-seccion">
        <a asp-action="EspecialidadForm" class="btn b-btn-primario">
            <i class="bi bi-plus-lg me-2"></i> Agregar Especialidad
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show b-alerta-exito" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card b-tarjeta-tabla">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table b-tabla mb-0">
                    <thead>
                        <tr>
                            <th class="text-center b-col-id">ID</th>
                            <th>Nombre de Especialidad</th>
                            <th>Clave Oficial</th>
                            <th class="text-center b-col-acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center align-middle b-celda-id">@item.IdEspecialidad</td>
                                    <td class="align-middle fw-medium">@item.Nombre</td>
                                    <td class="align-middle text-muted">@item.ClaveOficial</td>
                                    <td class="text-center align-middle">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="EspecialidadForm" asp-route-idEspecialidad="@item.IdEspecialidad" class="btn b-btn-icono-editar" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="EspecialidadDelete" asp-route-idEspecialidad="@item.IdEspecialidad" class="btn b-btn-icono-peligro" title="Eliminar" onclick="return confirm('¿Está seguro de eliminar esta especialidad permanentemente?');">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center b-estado-vacio">
                                    No hay especialidades registradas en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>