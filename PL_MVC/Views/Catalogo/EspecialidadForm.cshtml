@model ML.Especialidad

@{
    ViewData["Title"] = Model.IdEspecialidad > 0 ? "Editar Especialidad" : "Nueva Especialidad";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Catalogo/FormulariosEsp.css" asp-append-version="true" />
}

<div class="row g-5 justify-content-center b-area">

    <div class="row justify-content-center b-area-formulario">
        <div class="col-md-8 col-lg-6">
            <div class="card b-tarjeta-formulario">
                <div class="card-body p-5">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-danger b-alerta-error mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> @ViewBag.Message
                        </div>
                    }

                    <form asp-action="EspecialidadForm" method="post" class="b-formulario">
                        <input type="hidden" asp-for="IdEspecialidad" />

                        <div class="mb-4">
                            <label asp-for="Nombre" class="form-label b-label">Nombre de Especialidad <span class="b-requerido">*</span></label>
                            <input asp-for="Nombre" class="form-control b-input" required placeholder="Ej. Programación" />
                        </div>

                        <div class="mb-5">
                            <label asp-for="ClaveOficial" class="form-label b-label">Clave Oficial <span class="b-requerido">*</span></label>
                            <input asp-for="ClaveOficial" class="form-control b-input" required placeholder="Ej. PROG-01" />
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-2 border-top b-acciones-formulario">
                            <a asp-action="Especialidades" class="btn b-btn-secundario">Cancelar</a>
                            <button type="submit" class="btn b-btn-primario">
                                <i class="bi bi-check2 me-2"></i> Guardar Especialidad
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>