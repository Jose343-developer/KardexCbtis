@{
    ViewData["Title"] = "Gestión de Catálogos";
}

<div class="container mt-4">
    <div class="row text-center">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <i class="bi bi-diagram-3" style="font-size: 3rem; color: #0d6efd;"></i>
                    <h3 class="mt-3">Especialidades</h3>
                    <p class="text-muted">Añadir, modificar y eliminar las especialidades de la institución.</p>
                    <a asp-action="Especialidades" class="btn btn-primary mt-auto">Administrar Especialidades</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <i class="bi bi-people" style="font-size: 3rem; color: #198754;"></i>
                    <h3 class="mt-3">Grupos (Semestre y Turno)</h3>
                    <p class="text-muted">Gestionar los grupos académicos, turnos y semestres.</p>
                    <a asp-action="Grupos" class="btn btn-success mt-auto">Administrar Grupos</a>
                </div>
            </div>
        </div>
    </div>
</div>
