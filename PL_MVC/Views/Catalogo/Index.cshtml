@{
    ViewData["Title"] = "Gestión de Catálogos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Catalogo/Catalogos.css" asp-append-version="true" />
}

<div class="row g-5 justify-content-center b-area-tarjetas">
    <div class="row g-5 justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card b-tarjeta-catalogo h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-5">
                    <div class="b-icono-contenedor mb-4">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                    <h3 class="b-titulo-tarjeta">Especialidades</h3>
                    <p class="b-texto-tarjeta">Añadir, modificar y eliminar las especialidades de la institución.</p>
                    <a asp-action="Especialidades" class="btn b-btn-primario mt-auto">Administrar Especialidades</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-5">
            <div class="card b-tarjeta-catalogo h-100">
                <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-5">
                    <div class="b-icono-contenedor mb-4">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3 class="b-titulo-tarjeta">Grupos</h3>
                    <p class="b-texto-tarjeta">Gestionar los grupos académicos, turnos y semestres.</p>
                    <a asp-action="Grupos" class="btn b-btn-primario mt-auto">Administrar Grupos</a>
                </div>
            </div>
        </div>
    </div>
</div>