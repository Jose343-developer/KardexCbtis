@model List<ML.Grupo>

@{
    ViewData["Title"] = "Grupos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Catalogo/Grupos.css" asp-append-version="true" />
}

<div class="container-fluid mt-4 px-4 b-contenedor-principal">
    <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom b-header-seccion">
        
        <a asp-action="GrupoForm" class="btn b-btn-primario">
            <i class="bi bi-plus-lg me-2"></i> Agregar Grupo
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show b-alerta-exito" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card b-tarjeta-tabla">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table b-tabla mb-0">
                    <thead>
                        <tr>
                            <th class="text-center b-col-id">ID</th>
                            <th class="text-center">Semestre</th>
                            <th class="text-center">Letra</th>
                            <th class="text-center">Turno</th>
                            <th class="text-center b-col-acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center align-middle b-celda-id">@item.IdGrupo</td>
                                    <td class="text-center align-middle fw-medium">@item.Semestre</td>
                                    <td class="text-center align-middle fw-bold">@item.Letra</td>
                                    <td class="text-center align-middle">
                                        @if (item.Turno == "M" || item.Turno == "Matutino")
                                        {
                                            <span class="b-badge-turno b-turno-matutino">Matutino</span>
                                        }
                                        else if (item.Turno == "V" || item.Turno == "Vespertino")
                                        {
                                            <span class="b-badge-turno b-turno-vespertino">Vespertino</span>
                                        }
                                        else
                                        {
                                            <span class="b-badge-turno b-turno-otro">@item.Turno</span>
                                        }
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="GrupoForm" asp-route-idGrupo="@item.IdGrupo" class="btn b-btn-icono-editar" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="GrupoDelete" asp-route-idGrupo="@item.IdGrupo" class="btn b-btn-icono-peligro" title="Eliminar" onclick="return confirm('¿Está seguro de eliminar este grupo permanentemente?');">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center b-estado-vacio">
                                    No hay grupos registrados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>