@{
    ViewData["Title"] = "Boleta Oficial";
    var alumno = ViewBag.Alumno as ML.Alumno;
    var calificaciones = ViewBag.Calificaciones as List<ML.Calificacion>;
    
    decimal sumGrades = 0;
    int totalCredits = 0;
    int approvedSubjects = 0;
    int totalSubjects = calificaciones?.Count ?? 0;
    
    if (calificaciones != null && totalSubjects > 0)
    {
        sumGrades = calificaciones.Sum(c => c.Nota);
        totalCredits = calificaciones.Sum(c => c.Materia?.Creditos ?? 0);
        approvedSubjects = calificaciones.Count(c => c.Nota >= 6.00m);
    }
    
    decimal average = totalSubjects > 0 ? Math.Round(sumGrades / totalSubjects, 2) : 0;
}

<style>
    .boleta-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        padding: 40px;
        margin-top: 20px;
        border: 1px solid #e0e0e0;
    }
    
    .boleta-header {
        border-bottom: 3px double #7B2037;
        padding-bottom: 15px;
        margin-bottom: 25px;
    }
    
    .institucion-title {
        color: #7B2037;
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        letter-spacing: 1px;
    }
    
    .info-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #7f8c8d;
        font-weight: 600;
    }
    
    .info-value {
        font-size: 1rem;
        font-weight: 700;
        color: #2c3e50;
    }
    
    .table-boleta th {
        background-color: #7B2037 !important;
        color: white !important;
        font-weight: 600;
    }
    
    /* Reglas CSS específicas para la impresión */
    @@media print {
        body {
            background-color: #ffffff;
            color: #000000;
            font-size: 12pt;
        }
        
        /* Ocultar barra lateral de navegación y botones de la página */
        nav, .sidebar, .sidebar-wrapper, .navbar, .no-print, .btn, footer, .main-header {
            display: none !important;
        }
        
        .main-panel, .content, .container-fluid, .container {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            box-shadow: none !important;
        }
        
        .boleta-card {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        
        .table-boleta th {
            background-color: #f1f2f6 !important;
            color: #000000 !important;
            border: 1px solid #000000 !important;
        }
        
        .table-boleta td {
            border: 1px solid #000000 !important;
        }
    }
</style>

<div class="container py-4">
    <!-- Botones de Navegación e Impresión -->
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <a href="@Url.Action("GetAll", "Alumno")" class="btn btn-light rounded-pill shadow-sm">
            <i class="bi bi-arrow-left"></i> Volver a Alumnos
        </a>
        <button onclick="window.print()" class="btn btn-danger rounded-pill shadow-sm" style="background-color: #7B2037; border: none;">
            <i class="bi bi-printer-fill"></i> Imprimir / Exportar PDF
        </button>
    </div>

    @if (alumno != null)
    {
        <div class="boleta-card">
            <!-- Encabezado Institucional -->
            <div class="boleta-header text-center">
                <div class="row align-items-center">
                    <div class="col-md-2">
                        <!-- Espacio reservado para Logo -->
                        <span class="fs-1 text-muted"><i class="bi bi-mortarboard-fill" style="color: #7B2037;"></i></span>
                    </div>
                    <div class="col-md-8">
                        <h4 class="mb-1 fw-bold text-uppercase text-muted">Centro de Bachillerato Tecnológico industrial y de servicios</h4>
                        <h3 class="institucion-title text-uppercase mb-1">CBTis No. 133</h3>
                        <h5 class="fw-semibold text-secondary mb-0">Boleta de Calificaciones Histórica</h5>
                    </div>
                    <div class="col-md-2">
                        <span class="badge bg-success rounded-pill px-3 py-2 fs-6">@alumno.Estatus</span>
                    </div>
                </div>
            </div>

            <!-- Datos Generales del Alumno -->
            <div class="row g-3 mb-4 p-3 bg-light rounded-3">
                <div class="col-md-4">
                    <div class="info-label">Alumno</div>
                    <div class="info-value">@alumno.Nombre @alumno.ApellidoPaterno @alumno.ApellidoMaterno</div>
                </div>
                <div class="col-md-4">
                    <div class="info-label">Matrícula</div>
                    <div class="info-value font-monospace">@alumno.Matricula</div>
                </div>
                <div class="col-md-4">
                    <div class="info-label">CURP</div>
                    <div class="info-value font-monospace">@alumno.Curp</div>
                </div>

                <div class="col-md-4">
                    <div class="info-label">Especialidad</div>
                    <div class="info-value">@(alumno.Especialidad?.Nombre ?? "Tronco Común")</div>
                </div>
                <div class="col-md-4">
                    <div class="info-label">Semestre / Grupo</div>
                    <div class="info-value">@(alumno.Grupo?.Semestre)° Semestre - Grupo "@(alumno.Grupo?.Letra)" (@(alumno.Grupo?.Turno))</div>
                </div>
                <div class="col-md-4">
                    <div class="info-label">Clave Oficial</div>
                    <div class="info-value font-monospace">@(alumno.Especialidad?.ClaveOficial ?? "-")</div>
                </div>
            </div>

            <!-- Tabla de Calificaciones -->
            <h5 class="fw-bold mb-3" style="color: #7B2037;"><i class="bi bi-list-check"></i> Asignaturas Evaluadas</h5>
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-boleta align-middle">
                    <thead>
                        <tr class="text-center">
                            <th>Asignatura</th>
                            <th style="width: 120px;">Semestre</th>
                            <th style="width: 120px;">Créditos</th>
                            <th style="width: 120px;">Calificación</th>
                            <th style="width: 150px;">Estatus</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (calificaciones != null && calificaciones.Count > 0)
                        {
                            foreach (var cal in calificaciones)
                            {
                                <tr>
                                    <td class="fw-semibold">@cal.Materia?.Nombre</td>
                                    <td class="text-center">@cal.Materia?.Semestre°</td>
                                    <td class="text-center">@cal.Materia?.Creditos</td>
                                    <td class="text-center fw-bold fs-5">@cal.Nota.ToString("0.0")</td>
                                    <td class="text-center">
                                        @if (cal.Nota >= 6.00m)
                                        {
                                            <span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Aprobado</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-bold"><i class="bi bi-x-circle-fill"></i> Reprobado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    El alumno no cuenta con asignaturas calificadas en este periodo.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Resumen Académico -->
            <div class="row justify-content-end">
                <div class="col-md-5">
                    <div class="card p-3 shadow-sm border-0" style="background-color: #f8f9fa;">
                        <h6 class="fw-bold border-bottom pb-2 mb-3" style="color: #7B2037;">Resumen Académico</h6>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Materias Cursadas:</span>
                            <span class="fw-semibold">@totalSubjects</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Materias Aprobadas:</span>
                            <span class="fw-semibold text-success">@approvedSubjects</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Créditos Acumulados:</span>
                            <span class="fw-semibold">@totalCredits</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">Promedio General:</span>
                            <span class="fw-extrabold fs-4 text-primary">@average.ToString("0.00")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Firmas de Validez -->
            <div class="row mt-5 pt-4 text-center">
                <div class="col-md-4">
                    <div style="height: 60px;"></div>
                    <div class="border-top pt-2 mx-4" style="border-color: #ccc !important;">
                        <span class="fw-semibold d-block">Control Escolar</span>
                        <span class="text-muted fs-8">Firma Autorizada</span>
                    </div>
                </div>
                <div class="col-md-4"></div>
                <div class="col-md-4">
                    <div style="height: 60px;"></div>
                    <div class="border-top pt-2 mx-4" style="border-color: #ccc !important;">
                        <span class="fw-semibold d-block">Dirección Plantel</span>
                        <span class="text-muted fs-8">Sello y Firma</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
