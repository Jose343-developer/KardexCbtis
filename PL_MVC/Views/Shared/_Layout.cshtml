@using System.Linq
@{
    var user = Context.User;
    string nombreUsuario = "Invitado";
    string rolUsuario = "";
    string emailUsuario = "";
    bool isAuthenticated = false;

    if (user != null && user.Identity != null && user.Identity.IsAuthenticated)
    {
        isAuthenticated = true;
        emailUsuario = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value 
                       ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value 
                       ?? "";
        rolUsuario = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                     ?? user.FindFirst("role")?.Value 
                     ?? "";
        
        if (!string.IsNullOrEmpty(emailUsuario))
        {
            nombreUsuario = emailUsuario.Contains("@") ? emailUsuario.Split('@')[0] : emailUsuario;
            if (nombreUsuario.Contains("."))
            {
                var parts = nombreUsuario.Split('.');
                nombreUsuario = string.Join(" ", parts.Select(p => p.Length > 0 ? char.ToUpper(p[0]) + p.Substring(1) : ""));
            }
            else if (nombreUsuario.Length > 0)
            {
                nombreUsuario = char.ToUpper(nombreUsuario[0]) + nombreUsuario.Substring(1);
            }
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CBTis 133</title>
    <script type="importmap"></script>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PL_MVC.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="dashboard-container">
        
        <aside class="sidebar">
            <div class="sidebar-top">
                <div class="brand">
                    <img src="~/images/003.jpg" alt="CBTis 133" class="brand-logo">
                    <span class="brand-name">CBTis 133</span>
                </div>
                
                <nav class="nav-menu">
                    @if (isAuthenticated)
                    {
                        <a class="nav-item" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>

                        @if (rolUsuario.Equals("Administrador", StringComparison.OrdinalIgnoreCase))
                        {
                            <a class="nav-item" asp-area="" asp-controller="Catalogo" asp-action="Index">Catálogos</a>
                            <a class="nav-item" asp-area="" asp-controller="Horario" asp-action="Index">Subir Horarios</a>
                            <a class="nav-item" asp-area="" asp-controller="Reporte" asp-action="Dashboard">Estadísticas</a>
                            <a class="nav-item" asp-area="" asp-controller="Alumno" asp-action="AlumnoAdd">Agregar Alumno</a>
                            <a class="nav-item" asp-area="" asp-controller="Calendario" asp-action="GetAllCalendarView">Calendario</a>
                        }
                        else if (rolUsuario.Equals("Profesor", StringComparison.OrdinalIgnoreCase))
                        {
                            <a class="nav-item" asp-area="" asp-controller="Calendario" asp-action="GetAllCalendarView">Calendario</a>
                        }
                        else if (rolUsuario.Equals("Alumno", StringComparison.OrdinalIgnoreCase))
                        {
                            <a class="nav-item" asp-area="" asp-controller="Horario" asp-action="MiHorario">Mi Horario</a>
                            <a class="nav-item" asp-area="" asp-controller="Calificacion" asp-action="MisCalificaciones">Mis Calificaciones</a>
                        }

                        <a class="nav-item" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                    }
                    else
                    {
                        <a class="nav-item" asp-area="" asp-controller="Login" asp-action="Login">Iniciar Sesión</a>
                    }
                </nav>
            </div>

            <div class="sidebar-bottom">
                @if (isAuthenticated)
                {
                    <div class="user-profile mb-3">
                        <img src="~/images/perfil.png" alt="Usuario" class="user-avatar">
                        <div class="user-info">
                            <span class="user-name">@nombreUsuario</span>
                            <span class="user-email text-muted" style="font-size: 11px;">@rolUsuario</span>
                        </div>
                    </div>
                    <a class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2 rounded-3" asp-controller="Login" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                    </a>
                }
                else
                {
                    <a class="btn btn-primary btn-sm w-100 rounded-3" asp-controller="Login" asp-action="Login">
                        Iniciar Sesión
                    </a>
                }
            </div>
        </aside>

        <main class="main-content">
            
            <header class="page-header">
                <h1>@ViewData["Title"]</h1>
            </header>

            <section class="content-area">
                <div class="container-fluid pb-3">
                    @RenderBody()
                </div>
            </section>

            <footer class="page-footer">
                <p>&copy; 2026 - CBTIS No. 133 - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted">Privacy</a></p>
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>