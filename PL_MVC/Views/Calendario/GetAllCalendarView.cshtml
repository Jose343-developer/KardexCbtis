@model List<ML.CalendarObjects>
@{
    ViewData["Title"] = "Calendario Escolar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 1. Agregamos la librería FullCalendar desde su CDN -->
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js'></script>

@section Styles {
    <link rel="stylesheet" href="~/css/Calendario/GetAllCalendarView.css" asp-append-version="true" />
}

<div class="container">
    @if (ViewBag.CalendarError != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.CalendarError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (ViewBag.AsignacionError != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @ViewBag.AsignacionError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="calendar-card">
        <div class="calendar-header-wrapper">
            <div class="d-flex align-items-center flex-wrap gap-3">
                <h2 class="fw-bold mb-0" style="color: #2d3436;">Agenda del Sistema</h2>
                <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 d-flex align-items-center gap-2" style="background-color: #7B2037; border-color: #7B2037; font-weight: 600;" data-bs-toggle="modal" data-bs-target="#addEventModal">
                    <i class="bi bi-calendar-plus"></i> Nuevo Evento
                </button>
            </div>
            <div class="calendar-legend">
                <div class="legend-item">
                    <span class="legend-color color-primary"></span>
                    <span>Evento General</span>
                </div>
                <div class="legend-item">
                    <span class="legend-color color-class"></span>
                    <span>Horario de Clase</span>
                </div>
                <div class="legend-item">
                    <span class="legend-color color-tentative"></span>
                    <span>Tentativo</span>
                </div>
                <div class="legend-item">
                    <span class="legend-color color-cancelled"></span>
                    <span>Cancelado</span>
                </div>
            </div>
        </div>
        <hr class="mb-4" style="border-top: 2px solid #eee;">

        <!-- Filtros del Calendario -->
        <div class="calendar-filters mb-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="calendarSearchInput" class="form-control border-start-0 ps-0" placeholder="Buscar clases o eventos..." />
                    </div>
                </div>
                <div class="col-md-6 col-lg-8 d-flex flex-wrap gap-2 justify-content-md-end">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-btn active" data-filter="all">Todos</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 filter-btn" data-filter="class-schedule">Horarios de Clase</button>
                    <button class="btn btn-sm btn-outline-success rounded-pill px-3 filter-btn" data-filter="confirmed">Eventos Generales</button>
                    <button class="btn btn-sm btn-outline-warning rounded-pill px-3 filter-btn" data-filter="tentative">Tentativos</button>
                </div>
            </div>
        </div>

        <!-- Este div es donde FullCalendar dibujará toda la interfaz -->
        <div id='calendar' data-events="@Json.Serialize(Model)"></div>
    </div>
</div>

<!-- Modal para Crear Nuevo Evento -->
<div class="modal fade" id="addEventModal" tabindex="-1" aria-labelledby="addEventModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="addEventModalLabel"><i class="bi bi-calendar-plus text-danger me-2"></i>Crear Nuevo Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formAddEvent" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="eventTitle" class="form-label fw-semibold">Título del Evento</label>
                        <input type="text" class="form-control" id="eventTitle" required placeholder="ej. Examen Parcial, Junta de Profesores..." />
                        <div class="invalid-feedback">El título es obligatorio.</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="eventStartDate" class="form-label fw-semibold">Fecha/Hora de Inicio</label>
                            <input type="datetime-local" class="form-control" id="eventStartDate" required />
                            <div class="invalid-feedback">La fecha de inicio es obligatoria.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="eventEndDate" class="form-label fw-semibold">Fecha/Hora de Fin</label>
                            <input type="datetime-local" class="form-control" id="eventEndDate" required />
                            <div class="invalid-feedback">La fecha de fin es obligatoria.</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="eventLocation" class="form-label fw-semibold">Ubicación</label>
                        <input type="text" class="form-control" id="eventLocation" placeholder="ej. Biblioteca, Salón 5, Aula Virtual..." />
                    </div>
                    <div class="mb-3">
                        <label for="eventStatus" class="form-label fw-semibold">Estado / Categoría</label>
                        <select class="form-select" id="eventStatus" required>
                            <option value="confirmed" selected>Confirmado</option>
                            <option value="tentative">Tentativo</option>
                            <option value="cancelled">Cancelado</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="eventDescription" class="form-label fw-semibold">Descripción</label>
                        <textarea class="form-control" id="eventDescription" rows="3" placeholder="Información adicional sobre el evento..."></textarea>
                    </div>
                    
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4" style="background-color: #7B2037; border-color: #7B2037; font-weight: 600;">Guardar Evento</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Detalles del Evento -->
<div class="modal fade" id="eventDetailModal" tabindex="-1" aria-labelledby="eventDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="eventDetailModalLabel"><i class="bi bi-calendar-event text-danger me-2"></i>Detalles del Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center mb-3">
                    <div id="modalStatusBadge" class="badge rounded-pill px-3 py-2 fs-6"></div>
                </div>
                <h4 id="modalEventTitle" class="fw-bold mb-3 text-dark"></h4>
                <div class="mb-3 text-muted">
                    <i class="bi bi-clock-fill me-2 text-secondary"></i>
                    <span id="modalEventTime"></span>
                </div>
                <div class="mb-3 text-muted" id="modalEventLocationContainer">
                    <i class="bi bi-geo-alt-fill me-2 text-danger"></i>
                    <span id="modalEventLocation"></span>
                </div>
                <div class="mb-3 text-muted" id="modalEventDescriptionContainer">
                    <i class="bi bi-text-paragraph me-2 text-primary"></i>
                    <div id="modalEventDescription" class="mt-1 ps-3 text-dark" style="white-space: pre-line; border-left: 3px solid #eee;"></div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 d-flex justify-content-between">
                <button type="button" id="btnDeleteEvent" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-none">
                    <i class="bi bi-trash me-1"></i> Eliminar Evento
                </button>
                <div class="ms-auto">
                    <button type="button" class="btn btn-light btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Calendario/GetAllCalendarView.js" asp-append-version="true"></script>
}