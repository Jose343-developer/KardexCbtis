@model ML.Alumno
@{
    ViewData["Title"] = "MIS DATOS";
}

<style>
    :root {
        --apple-bg: rgba(255, 255, 255, 0.7);
        --apple-bg-solid: #ffffff;
        --apple-blur: blur(24px);
        --apple-border: rgba(0, 0, 0, 0.1);
        --apple-text-primary: #1c1c1e;
        --apple-text-secondary: #8e8e93;
        --apple-radius: 20px;
        --font-family-apple: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .apple-container {
        font-family: var(--font-family-apple);
        color: var(--apple-text-primary);
    }

    .apple-card {
        background: var(--apple-bg);
        border: 1px solid var(--apple-border);
        backdrop-filter: var(--apple-blur);
        -webkit-backdrop-filter: var(--apple-blur);
        border-radius: var(--apple-radius);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
    }

    .apple-header {
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .apple-subtext {
        color: var(--apple-text-secondary);
        font-weight: 400;
        font-size: 15px;
    }

    .apple-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .apple-list-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 0.5px solid var(--apple-border);
    }

    .apple-list-item:last-child {
        border-bottom: none;
    }
</style>

<div class="apple-container mt-4 animate-fade-in d-flex justify-content-center">
    <div style="width: 100%; max-width: 800px;">
        
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="apple-card p-4 p-md-5 text-center">
                    <h2 class="apple-header mb-1">@Model.Nombre @Model.ApellidoPaterno</h2>
                    <span class="apple-subtext">Panel de Estudiante</span>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <!-- School Information -->
            <div class="col-12">
                <div class="apple-card p-0 overflow-hidden">
                    <div class="p-4 border-bottom" style="border-color: var(--apple-border) !important;">
                        <h5 class="apple-header m-0 text-center" style="font-size: 18px;">Información Escolar</h5>
                    </div>
                    <ul class="apple-list">
                        <li class="apple-list-item">
                            <span class="apple-subtext">Matrícula</span>
                            <span class="fw-medium">@Model.Matricula</span>
                        </li>
                        <li class="apple-list-item">
                            <span class="apple-subtext">Especialidad</span>
                            <span class="fw-medium">@(Model.Especialidad?.Nombre ?? "Sin Asignar")</span>
                        </li>
                        <li class="apple-list-item">
                            <span class="apple-subtext">Grupo</span>
                            <span class="fw-medium">@(Model.Grupo?.Semestre ?? 0)° "@(Model.Grupo?.Letra ?? "N/A")"</span>
                        </li>
                        <li class="apple-list-item">
                            <span class="apple-subtext">Turno</span>
                            <span class="fw-medium">@(Model.Grupo?.Turno ?? "Sin Asignar")</span>
                        </li>
                        <li class="apple-list-item">
                            <span class="apple-subtext">CURP</span>
                            <span class="fw-medium">@Model.Curp</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

    </div>
</div>
