@model ML.Alumno
@{
    ViewData["Title"] = "Mis Calificaciones";
    decimal promedio = ViewBag.Promedio ?? 0;
}

<div class="row mb-4 animate-fade-in">
    <div class="col-12">
        <div class="card border-0 shadow-sm p-4 rounded-4" style="background: rgba(30, 41, 59, 0.45); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); color: #f8fafc;">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-30 px-3 py-2 rounded-pill mb-3">Panel de Estudiante</span>
                    <h2 class="fw-bold mb-1" style="letter-spacing: -0.5px;">¡Hola, @Model.Nombre @Model.ApellidoPaterno!</h2>
                    <p class="text-muted mb-0" style="color: #94a3b8 !important;">Consulta tus calificaciones del ciclo escolar actual y tu promedio acumulado.</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="d-inline-block text-center p-3 rounded-4" style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.05); min-width: 160px;">
                        <span class="text-muted d-block mb-1" style="font-size: 13px; color: #94a3b8 !important;">Promedio General</span>
                        <span class="fs-1 fw-bold @(promedio >= 8 ? "text-success" : promedio >= 6 ? "text-warning" : "text-danger")">
                            @promedio.ToString("0.0")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <!-- Student Information Card -->
    <div class="col-lg-4 mb-4 mb-lg-0">
        <div class="card border-0 shadow-sm h-100 rounded-4" style="background: rgba(30, 41, 59, 0.45); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); color: #f8fafc;">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                <h5 class="fw-bold m-0" style="font-size: 17px;"><i class="bi bi-info-circle text-primary me-2"></i> Datos Escolares</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="text-muted d-block" style="font-size: 12px; color: #94a3b8 !important;">Matrícula</span>
                    <span class="fw-semibold">@Model.Matricula</span>
                </div>
                <div class="mb-3">
                    <span class="text-muted d-block" style="font-size: 12px; color: #94a3b8 !important;">Especialidad</span>
                    <span class="fw-semibold">@(Model.Especialidad?.Nombre ?? "Sin Asignar")</span>
                </div>
                <div class="mb-3">
                    <span class="text-muted d-block" style="font-size: 12px; color: #94a3b8 !important;">Grupo / Semestre</span>
                    <span class="fw-semibold">@(Model.Grupo?.Semestre ?? 0)° "@(Model.Grupo?.Letra ?? "N/A")"</span>
                </div>
                <div class="mb-3">
                    <span class="text-muted d-block" style="font-size: 12px; color: #94a3b8 !important;">Turno</span>
                    <span class="fw-semibold">@(Model.Grupo?.Turno ?? "Sin Asignar")</span>
                </div>
                <div class="mb-0">
                    <span class="text-muted d-block" style="font-size: 12px; color: #94a3b8 !important;">CURP</span>
                    <span class="fw-semibold">@Model.Curp</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Grades List -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100 rounded-4" style="background: rgba(30, 41, 59, 0.45); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); color: #f8fafc;">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
                <h5 class="fw-bold m-0" style="font-size: 17px;"><i class="bi bi-journal-check text-primary me-2"></i> Calificaciones Registradas</h5>
            </div>
            <div class="card-body p-4">
                @if (Model.Calificaciones == null || Model.Calificaciones.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-clipboard-x text-muted" style="font-size: 48px;"></i>
                        <p class="text-muted mt-3">Aún no se han asentado calificaciones para este periodo.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-borderless align-middle" style="background: transparent;">
                            <thead>
                                <tr style="border-bottom: 2px solid rgba(255, 255, 255, 0.05); color: #94a3b8;">
                                    <th scope="col" class="pb-3 ps-0">Materia</th>
                                    <th scope="col" class="pb-3 text-center">Semestre</th>
                                    <th scope="col" class="pb-3 text-center">Créditos</th>
                                    <th scope="col" class="pb-3 text-end pe-0">Calificación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Calificaciones)
                                {
                                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                        <td class="py-3 ps-0 fw-semibold text-white">@item.Materia?.Nombre</td>
                                        <td class="py-3 text-center">@item.Materia?.Semestre°</td>
                                        <td class="py-3 text-center text-muted">@item.Materia?.Creditos</td>
                                        <td class="py-3 text-end pe-0">
                                            <span class="badge rounded-pill px-3 py-2 fw-bold fs-6 @(item.Nota >= 8 ? "bg-success bg-opacity-10 text-success border border-success border-opacity-20" : item.Nota >= 6 ? "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-20" : "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20")">
                                                @item.Nota.ToString("0.0")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
